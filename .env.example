# 빈 값만 공유합니다. 실제 키는 각자의 .env에 보관합니다.
# 현재 demo 모드는 API 키, LLM 호출, 모델 다운로드가 필요 없습니다.
OPENAI_API_KEY=
LLM_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-startup-investment-agent
# 팀이 실제 비교 후 선정합니다. OpenAIEmbeddings는 과제 조건에 맞지 않습니다.
EMBEDDING_MODEL=
# PDF 한글 글꼴을 직접 지정할 때만 사용합니다. 글꼴 파일은 저장소에 올리지 않습니다.
REPORT_FONT_PATH=
